<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
	<metadata>
		<id>Xreeple.Bukalemun.Providers</id>
		<title>Xreeple.Bukalemun.Providers</title>
		<version>1.0.2</version>
		<authors>Xreeple</authors>
		<license type="expression">MIT</license>
		<projectUrl>https://github.com/xreeple</projectUrl>
		<repository type="git" url="https://github.com/xreeple/bukalemun.git" />
		<description>Bukalemun is a flexible and Secure Data Encryption Library for .NET Bukalemun is a lightweight and flexible encryption library for .NET applications, designed to securely store sensitive and personal data in databases.</description>
		<releaseNotes>Fixed Turkish character (Ş, Ğ, İ, Ç, Ö, Ü) encoding issue in encryption/decryption. Now properly handles Unicode characters using UTF-8 encoding. Note: Data encrypted with previous versions may need to be re-encrypted.</releaseNotes>
		<copyright>Copyright © 2025 Xreeple</copyright>
		<tags>secure data encryption sensitive personal dotnet</tags>
		<icon>chameleon.png</icon>
		
		<dependencies>
			<group targetFramework="net9.0">
				<dependency id="BCrypt.Net-Next" version="4.0.3" />
				<dependency id="CryptoNet" version="2.4.0" />
			</group>
			
			<group targetFramework="net7.0">
				<dependency id="BCrypt.Net-Next" version="4.0.3" />
				<dependency id="CryptoNet" version="2.4.0" />
			</group>
		</dependencies>
	</metadata>

	<files>
		<file src="bin\Release\net9.0\Xreeple.Bukalemun.Providers.dll" target="lib\net9.0" />
		<file src="bin\Release\net7.0\Xreeple.Bukalemun.Providers.dll" target="lib\net7.0" />
		<file src="LICENSE" />
		<file src="chameleon.png" />
	</files>
</package>